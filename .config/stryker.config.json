{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "web/vitest.config.ts"
  },
  "mutate": [
    "web/src/**/*.ts",
    "!web/src/**/*.test.ts"
  ],
  "ignorePatterns": [
    "/*",
    "!/web",
    "!/package.json"
  ],
  "disableTypeChecks": false,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "reporters": [
    "clear-text"
  ],
  "tempDirName": ".tools/stryker-tmp",
  "cleanTempDir": "always",
  "clearTextReporter": {
    "logTests": false
  }
}
