{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["web/**", "!web/templates", "*.json", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/vite.config.ts", "web/vitest.config.ts", "web/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": {
              "level": "error",
              "options": {
                "devDependencies": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error",
            "noPrivateImports": "error"
          },
          "suspicious": {
            "noImportCycles": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["/**", "**/..", "**/../**", "!../shared/*"],
                    "message": "Modules in web/src/ are flat folders that import only their own files and one level into web/src/shared/ (ADR-0056)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
