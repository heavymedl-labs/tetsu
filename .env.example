# Local settings for tetsu (ADR-0050). Copy this file to .env, which git and the image build ignore. A variable set
# in the environment wins over the file, except that mail settings come all from one or all from the other
# (ADR-0078). The address is the test Postgres from AGENTS.md, with a database of its own.
DATABASE_URL=postgres://postgres@localhost:54329/tetsu_local
DATABASE_TLS=disable
TETSU_DEMO=true
# This machine serves every realm on one origin; production gives each realm a host of its own (ADR-0092).
# Invite links point to their realm's origin.
TETSU_SERVES=site,admin,staff
TETSU_ADMIN_ORIGIN=http://localhost:8080
TETSU_STAFF_ORIGIN=http://localhost:8080
# No proxy stands in front locally, so rate limits key on the connection's address (ADR-0072).
TETSU_TRUSTED_PROXIES=0
# Logs are text in a terminal and JSON elsewhere; json shows the lines a host collects.
# TETSU_LOG_FORMAT=json
# Mail (ADR-0074): without TETSU_SMTP_HOST, notices are kept for the mailbox page rather than sent, and an
# invite, never kept, is only printed. scripts/mailpit.py runs a local Mailpit to see them in, with settings of
# its own for `cargo tetsu --env mailpit`; all of them are in crates/tetsu/README.md.
