# Local settings for tetsu (ADR-0050). Copy this file to .env, which git and the image build ignore. A variable set
# in the environment wins over the file. The address is the test Postgres from AGENTS.md, with a database of its own.
DATABASE_URL=postgres://postgres@localhost:54329/tetsu_local
DATABASE_TLS=disable
TETSU_DEMO=true
# The site's own origin, which invite links point to.
TETSU_ORIGIN=http://localhost:8080
